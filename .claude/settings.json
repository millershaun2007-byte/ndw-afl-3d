{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/deploy-gate.sh\"",
            "statusMessage": "Checking commits since last deploy..."
          }
        ]
      }
    ]
  }
}
